NODE_ENV=development
PORT=5000

# MongoDB Atlas. If the password has special characters, URL-encode them (@ becomes %40).
# Local alternative: mongodb://127.0.0.1:27017/upang_delivers
MONGODB_URI=mongodb+srv://db_user:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/upang_delivers?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h

# Administrator provisioned by the system owner (no built-in admin account).
ADMIN_NAME=Your Name
ADMIN_EMAIL=your.admin@phinmaed.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
DEMO_PASSWORD=replace-with-a-strong-demo-password

BCRYPT_ROUNDS=12

# Rate limiting on /api/auth/*
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=5

# CORS: your frontend's origin (use the deployed URL in production)
CORS_ORIGIN=http://localhost:5173

# Brevo transactional email API (HTTPS; works on Render free web services).
# Generate an API key under Brevo Settings → SMTP & API → API keys.
# Store this only in the backend host's environment settings; never commit it.
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=Upang Delivers <your-verified-sender@your-domain.com>

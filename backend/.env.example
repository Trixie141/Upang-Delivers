NODE_ENV=development
PORT=5000

# MongoDB Atlas. If the password has special characters, URL-encode them (@ becomes %40).
# Local alternative: mongodb://127.0.0.1:27017/upang_delivers
MONGODB_URI=mongodb+srv://db_user:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/upang_delivers?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h

# Administrator provisioned by the system owner (no built-in admin account).
ADMIN_NAME=Your Name
ADMIN_EMAIL=your.admin@phinmaed.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
DEMO_PASSWORD=replace-with-a-strong-demo-password

BCRYPT_ROUNDS=12

# Rate limiting on /api/auth/*
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=5

# CORS: your frontend's origin (use the deployed URL in production)
CORS_ORIGIN=http://localhost:5173

# Brevo SMTP. Use the SMTP login and SMTP key from Brevo (not an API key).
# Store these only in the backend host's environment settings; never commit secrets.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=Upang Delivers <your-verified-sender@your-domain.com>

NODE_ENV=development
PORT=5000

# MongoDB Atlas. If the password has special characters, URL-encode them (@ becomes %40).
# Local alternative: mongodb://127.0.0.1:27017/upang_delivers
MONGODB_URI=mongodb+srv://db_user:URL_ENCODED_PASSWORD@cluster.example.mongodb.net/upang_delivers?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=2h

BCRYPT_ROUNDS=12

# Rate limiting on /api/auth/*
AUTH_RATE_WINDOW_MS=60000
AUTH_RATE_MAX=5

# CORS: your frontend's origin (use the deployed URL in production)
CORS_ORIGIN=http://localhost:5173

# SMTP email (Gmail example). For Gmail, use a dedicated sender account and an
# app password if the account permits it. Never commit SMTP_PASS or share it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-app-sender@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM=Upang Delivers <your-app-sender@gmail.com>
